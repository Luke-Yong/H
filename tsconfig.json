{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "client", "server/__tests__"]
}
